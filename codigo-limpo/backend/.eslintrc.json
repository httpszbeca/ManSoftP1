{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": ["airbnb-base", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-console": "off",
    "no-plusplus": "off",
    "import/no-dynamic-require": "off",
    "global-require": "off"
  }
}


